# A separate image containing ONLY the functional test module -- it has no
# dependency on order-api at all (see order-api-functional-tests/pom.xml),
# so there's nothing to build here except the tests themselves. This image
# is meant to run as an OpenShift Job against an already-deployed
# order-api-springboot Service, with ORDERAPI_BASE_URL supplied at Job
# creation time.

FROM maven:3-eclipse-temurin-21

# OpenShift Jobs run under the restricted SCC with an arbitrary,
# randomly-assigned non-root UID that has no /etc/passwd entry, so Maven
# can't resolve a home directory for it. Same class of problem, same fix
# shape, as the DOTNET_CLI_HOME issue hit on the .NET version of this demo:
# give it a HOME that's writable regardless of UID.
ENV HOME=/tmp

WORKDIR /src
COPY order-api-functional-tests/ ./order-api-functional-tests/

WORKDIR /src/order-api-functional-tests

# Run through the `test` phase (not just `test-compile`) so Maven resolves
# and caches the Surefire plugin itself into /tmp/.m2/repository --
# test-compile stops one phase too early for that, since Surefire only
# gets invoked during `test`. -DskipTests means it runs (and gets cached)
# without actually executing the tests, which would fail here anyway
# since there's no live ORDERAPI_BASE_URL yet at build time.
RUN mvn -B -DskipTests -Dmaven.repo.local=/tmp/.m2/repository test

# -o (offline) forces Maven to use only what was already cached into
# /tmp/.m2/repository during the build above -- no network access needed
# (or attempted) when this actually runs as a Job.
ENTRYPOINT ["mvn", "-B", "-o", "-Dmaven.repo.local=/tmp/.m2/repository", "test"]