<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>order-api</artifactId>
  <version>1.0.0</version>
  <name>order-api</name>
  <description>Order pricing API - testing pyramid demo (Spring Boot)</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Spring Boot 4 moved TestRestTemplate out of spring-boot-starter-test
      and into this dedicated artifact, it must be declared explicitly
      now, unlike in Spring Boot 3.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-resttestclient</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      spring-boot-resttestclient's TestRestTemplateTestAutoConfiguration
      references RestTemplateBuilder, which now lives in this separate
      module and is not pulled in transitively by either
      spring-boot-starter-web or spring-boot-resttestclient in Boot 4.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-restclient</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Fixed name so the Dockerfile can COPY a predictable jar path
         instead of globbing for a version-suffixed filename. -->
    <finalName>order-api</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        Surefire (unit tests, *Test.java / *Tests.java) runs automatically
        during `mvn test`/`mvn verify` via Spring Boot's parent POM.

        Failsafe (integration tests, *IT.java) does NOT run automatically,
        it must be explicitly bound to the integration-test/verify phases,
        which is what this does. This is the Java/Maven idiom for the same
        unit-vs-integration boundary the .NET version draws with separate
        test projects: naming convention + plugin choice instead of a
        separate assembly.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>